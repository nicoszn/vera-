datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model AgentTask {
  id          String   @id @default(uuid())
  objective   String
  status      String   @default("PENDING") 
  logs        Json[]   @default([])        
  output      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
